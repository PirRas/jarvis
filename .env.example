# Vorlage für eigene Instanzen. Kopieren nach .env.local und ausfüllen.
# .env.local ist per .gitignore ausgeschlossen. Echte Geheimnisse nie in .env oder in diese Datei schreiben.

# --- Öffentlich (landen im Browser) ---
# Supabase → Project Settings → API. Der Publishable Key ist für den Browser gedacht; geschützt wird über RLS (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Web-Push: Schlüsselpaar mit `npx web-push generate-vapid-keys` erzeugen
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Impressum und Datenschutzerklärung (/impressum, /datenschutz)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DATA_REGION=
# Nur mit eigener Domain (Canonical, Sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=

# --- Geheim (nur Server: Vercel → Environment Variables oder .env.local) ---
SUPABASE_SECRET_KEY=
VAPID_PRIVATE_KEY=
PUSH_CRON_SECRET=

# --- Nur für lokale Skripte (scripts/) ---
# GEMINI_API_KEY=        # scripts/lecture-check.ts
# JARVIS_EMAIL=          # scripts/nachbereitung-save.ts (Konto aus der App)
# JARVIS_PASSWORD=
# JARVIS_TOTP_CODE=      # falls 2FA aktiv
# JARVIS_APP_URL=        # Android-Build gegen eine Vorschau statt nachbereitung.vercel.app
